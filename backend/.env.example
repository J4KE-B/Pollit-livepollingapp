PORT=5000
MONGO_URI=mongodb://localhost:27017/livepoll
JWT_SECRET=replace_this_with_a_long_random_string_min_32_chars
CLIENT_URL=http://localhost:4200
GEMINI_API_KEY=

# --- Rate limiting (express-rate-limit, see src/app.js) ---
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=20

# --- Abuse / anomaly detection (see src/security/abuseDetector.js + SECURITY_DEFENSE.md) ---
# All optional; the defaults below are what ship. Tune per venue.
ABUSE_DETECTION_ENABLED=true

# Vote-rate spike detection (sliding window)
ABUSE_VOTE_WINDOW_MS=10000
ABUSE_MAX_VOTES_PER_FP=8        # per device. A human taps once per poll; a bot does 50 in 2s.
ABUSE_MAX_VOTES_PER_IP=300      # per egress IP. Sized ABOVE a big room on shared NAT -- raise
                                # this for very large venues, or a full lecture hall answering
                                # simultaneously can trip it.

# Fingerprint clustering (cardinality within the window)
ABUSE_CLUSTER_WINDOW_MS=60000
ABUSE_MAX_KEYS_PER_FP=3         # distinct voterKeys per device. >3 == deliberately clearing
                                # storage to defeat the one-vote-per-voter unique index.
ABUSE_MAX_FPS_PER_IP=25         # distinct devices per IP. FLAG ONLY by default: a lecture hall
                                # behind one NAT looks exactly like a bot farm by this metric.
ABUSE_BLOCK_ON_IP_CLUSTER=false # set true ONLY where shared NAT is not expected. Blocking on
                                # this in a classroom would ban the whole audience.

# Enforcement
ABUSE_BLOCK_MS=60000            # cooldown, not a permaban
